{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "deriv-analysis": {
      "root": "artifacts/deriv-analysis",
      "framework": "vite",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/mockup/:path*",
      "destination": {
        "service": "mockup-sandbox",
        "path": "/:path*"
      }
    },
    {
      "source": "/mockup",
      "destination": {
        "service": "mockup-sandbox",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "deriv-analysis"
      }
    }
  ]
}
